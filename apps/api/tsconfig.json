{
  "extends": "@fin/config/tsconfig.node.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "noUncheckedIndexedAccess": false,
    // multer is listed explicitly because the base config pins `types` to node,
    // and FileInterceptor's Express.Multer.File comes from a global augmentation
    // that is otherwise never loaded. The import wizard uploads a statement, so
    // this one is load-bearing rather than precautionary.
    "types": ["node", "multer"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "src/**/*.test.ts"]
}
