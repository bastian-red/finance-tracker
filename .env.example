# Copy to .env and fill in. Never commit .env — it is gitignored and the
# pre-commit hook runs gitleaks over staged changes.

# --- Core ---
NODE_ENV=development

# --- Database (Postgres) ---
# Published on 5436 to avoid clashing with a host PostgreSQL on 5432 and with the
# other portfolio stacks on 5433/5434/5435.
DATABASE_URL=postgresql://fin:fin@localhost:5436/fin?schema=public
# Direct (unpooled) connection, used only by `prisma migrate`. Locally this is the
# same value; behind a transaction-mode pooler it is the provider's direct URL,
# because migrations cannot run through one.
DIRECT_DATABASE_URL=postgresql://fin:fin@localhost:5436/fin?schema=public

# --- Redis ---
# Rate limiting and the monthly report cache. The cache is invalidated on every
# write that touches the month, so it is never the source of truth.
REDIS_URL=redis://localhost:6383

# --- API service ---
API_PORT=4000
# Server-to-server base URL.
API_BASE_URL=http://localhost:4000

# --- Web app ---
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
# Browser-visible API URL. Baked at build time by infra/Dockerfile.web.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Auth ---
# Shared by web (Auth.js session + service-token minting) and api (token
# verification). Must be >= 16 chars. Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Money ---
# ISO 4217 code for the default account currency, and the locale used to parse
# ambiguous amounts when a statement does not make the decimal separator obvious.
# `1.234,56` and `1,234.56` are the same number under different locales, and
# guessing wrong is a 1000x error, so the fallback is explicit rather than
# inferred from the machine.
DEFAULT_CURRENCY=EUR
DEFAULT_LOCALE=es-ES

# --- Import ---
# Largest accepted statement upload, in bytes (8 MB). A year of transactions from
# any real bank is well under 1 MB; the ceiling exists to stop a mis-selected file
# from being parsed at all.
MAX_IMPORT_BYTES=8388608
# Where uploaded statements are kept so a failed import can be re-read and
# explained. Never served: every byte goes through an authenticated route.
IMPORT_ROOT=./var/imports
# A transaction within this many days of another with the same amount and
# description is flagged as a possible duplicate for review rather than dropped.
# People genuinely do buy the same coffee twice.
DUPLICATE_WINDOW_DAYS=3

# --- Reports ---
# How long a cached monthly rollup lives if nothing invalidates it first. Writes
# delete the key immediately, so this is only a backstop against a missed
# invalidation, not the correctness mechanism.
REPORT_CACHE_TTL_SECONDS=900

# --- Budgets ---
# Share of a budget that has to be spent before the "approaching" alert fires.
# Below 1 because an alert that arrives at 100% is not a warning, it is a receipt.
BUDGET_ALERT_THRESHOLD=0.8

# --- Email ---
# Local dev uses Mailhog (docker-compose). Leave SMTP_HOST empty to fall back to
# the log channel, which prints instead of sending and never throws.
SMTP_HOST=localhost
SMTP_PORT=1029
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=alerts@finance.local

# --- Rate limits (requests per minute, per client IP) ---
# Import gets its own, much tighter budget: one upload parses thousands of rows,
# so it costs far more than an ordinary read.
RATE_LIMIT_GLOBAL=120
RATE_LIMIT_AUTH=5
RATE_LIMIT_IMPORT=10
